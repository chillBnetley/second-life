# ---- 前端（会被打包进浏览器，千万不要放密钥）----
VITE_AI_ENABLED=false
VITE_STORAGE=local
# 第四阶段（Supabase）预留，anon key 本来就是公开的
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 服务端代理（server/proxy.mjs 读取，不会进入前端包）----
# 提示：也可以直接在网页「AI 设置」里填 Key（保存到 .ai-config.json，网页配置优先于本文件）。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=8787
# 允许跨域调用代理的站点（逗号分隔；localhost:5173/4173 默认已允许）
ALLOWED_ORIGIN=
# 每日全局预算：超过后代理返回 503，前端自动回落本地剧情
DAILY_CALL_BUDGET=500
DAILY_TOKEN_BUDGET=300000
UPSTREAM_TIMEOUT_MS=30000